<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.carlearn.ui.MainFragment"
        android:label="MainFragment"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_examFragment"
            app:destination="@id/examFragment" />
    </fragment>

    <fragment
        android:id="@+id/examFragment"
        android:name="com.example.carlearn.feature.exam.ExamFragment"
        android:label="ExamFragment"
        tools:layout="@layout/fragment_exam" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.carlearn.ui.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/questionBankFragment"
        android:name="com.example.carlearn.ui.QuestionBankFragment"
        android:label="题库" />

</navigation>